# ==============================================================================
# Enterprise Banking RAG Assistant - Environment Configuration Template
# Copy this file to .env and insert your API keys. NEVER commit .env to git!
# ==============================================================================

# Application Environment & Server
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
SECRET_KEY=dev-secret-key-change-in-production-32-chars-min

# ------------------------------------------------------------------------------
# LLM PROFILE: mock | dev | demo
#   mock = deterministic fake LLM, no network, 0 quota (default for all tests)
#   dev  = free-tier or 100% local Ollama provider for day-to-day development ($0 cost)
#   demo = paid provider for demonstrations and final evaluation runs
# Switching profile requires no code change.
# ------------------------------------------------------------------------------
LLM_PROFILE=dev

# dev profile: Option 1 - Remote Free-Tier OpenAI-Compatible Provider (e.g., Groq)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_free_tier_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# dev profile: Option 2 - 100% Local $0 Ollama (No network, private, OpenAI-compatible)
# Step 1: Install Ollama (https://ollama.ai)
# Step 2: In terminal run: ollama run llama3.1:8b   (or: ollama run qwen2.5:7b-instruct)
# Step 3: Set in .env:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.1:8b

# demo profile (paid, OpenAI-compatible) - required only when LLM_PROFILE=demo
DEMO_LLM_BASE_URL=https://api.openai.com/v1
DEMO_LLM_API_KEY=sk-your_paid_api_key_here
DEMO_LLM_MODEL=gpt-4o-mini

# Optional dev-only failover (leave blank to disable; never used under demo)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# LLM Wrapper Behaviour
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RPM=20
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0

# Prompt Registry & Response Cache
PROMPT_VERSION=v1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=30

# Spend Guard (live/paid quota only — mock & local Ollama never enforce paid caps)
# Per-query limits reset cleanly on every user query; session limits protect cumulative session spend.
LLM_MAX_CALLS_PER_RUN=25
LLM_MAX_TOKENS_PER_RUN=120000
LLM_MAX_CALLS_PER_SESSION=150
LLM_MAX_TOKENS_PER_SESSION=400000
LLM_LOCAL_SAFETY_CALLS=1000
LLM_LOCAL_SAFETY_TOKENS=4000000

# Local CPU Embeddings & Re-ranker Models (No GPU required)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage
DATABASE_PATH=./data/sqlite/app.db
QDRANT_STORAGE_PATH=./data/qdrant

# Ablation Flags (Enable/Disable layers independently)
# The adaptive router is configured in the Phase 4 section below.
ENABLE_CORRECTIVE_GRADER=true
ENABLE_RBAC_MEMORY=false
ENABLE_XAI_OUTPUT=true
ENABLE_HEADING_PATH=true
ENABLE_CLAIM_CHECK=false
ENABLE_CALCULATOR=false

# ------------------------------------------------------------------------------
# PHASE 3: ACCESS CONTROL & CONVERSATIONAL MEMORY
# ENABLE_RBAC defaults to true and may only be false when APP_ENV=test or when
# BASELINE_ABLATION=true (a labelled ablation run). Any other combination is
# refused at startup so a typo can never expose restricted documents.
# ENABLE_MEMORY defaults to false for baseline experiments; set true for the app.
# ------------------------------------------------------------------------------
ENABLE_RBAC=true
ENABLE_MEMORY=true
BASELINE_ABLATION=false
MEMORY_MAX_TURNS=6

# Local demo authentication (synthetic users only; no production identity provider)
AUTH_TOKEN_TTL_MINUTES=60
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=60
API_UPLOAD_RATE_LIMIT_PER_MINUTE=20

# Password used by scripts/seed_data.py for the synthetic demo users.
# REQUIRED outside APP_ENV=test: the seed script refuses to run without it, so
# a shared environment can never be seeded with a known default. Override it
# locally and never commit a real credential.
SEED_DEFAULT_PASSWORD=change-me-locally

# ------------------------------------------------------------------------------
# PHASE 4: ADAPTIVE ROUTER (Layer 1)
# Routes: DIRECT_REPLY (fixed templates, no retrieval), SINGLE_SEARCH (baseline
# path), MULTI_PART_SPLIT (2-3 sub-questions, one generation). Any router
# failure or low confidence degrades to SINGLE_SEARCH, never to a direct reply.
# ------------------------------------------------------------------------------
ENABLE_ADAPTIVE_ROUTER=true
ROUTER_CONFIDENCE_THRESHOLD=0.6
ROUTER_MAX_SUB_QUESTIONS=3
ROUTER_MAX_RETRIEVAL_CALLS=3

# Search Hyperparameters
RETRIEVAL_TOP_K_HYBRID=20
RETRIEVAL_RRF_K=60
RERANKER_TOP_N=5
GRADER_RELEVANCE_THRESHOLD=0.65
