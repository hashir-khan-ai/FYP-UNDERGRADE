# ==============================================================================
# Enterprise Banking RAG Assistant - Environment Configuration Template
# Copy this file to .env and insert your API keys. NEVER commit .env to git!
# ==============================================================================

# Application Environment & Server
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
SECRET_KEY=dev-secret-key-change-in-production-32-chars-min

# ------------------------------------------------------------------------------
# LLM PROFILE: mock | dev | demo
#   mock = deterministic fake LLM, no network, 0 quota (default for all tests)
#   dev  = free-tier provider for day-to-day development
#   demo = paid provider for demonstrations and final evaluation runs
# Switching profile requires no code change.
# ------------------------------------------------------------------------------
LLM_PROFILE=dev

# dev profile (free-tier, OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_free_tier_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# demo profile (paid, OpenAI-compatible) - required only when LLM_PROFILE=demo
DEMO_LLM_BASE_URL=https://api.openai.com/v1
DEMO_LLM_API_KEY=sk-your_paid_api_key_here
DEMO_LLM_MODEL=gpt-4o-mini

# Optional dev-only failover (leave blank to disable; never used under demo)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# LLM Wrapper Behaviour
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RPM=20
LLM_MAX_RETRIES=3

# Prompt Registry & Response Cache
PROMPT_VERSION=v1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=30

# Spend Guard (per run; evaluation applies one budget per full benchmark run)
LLM_MAX_CALLS_PER_RUN=40
LLM_MAX_TOKENS_PER_RUN=120000

# Local CPU Embeddings & Re-ranker Models (No GPU required)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Storage
DATABASE_PATH=./data/sqlite/app.db
QDRANT_STORAGE_PATH=./data/qdrant

# Ablation Flags (Enable/Disable layers independently)
ENABLE_ADAPTIVE_ROUTER=true
ENABLE_CORRECTIVE_GRADER=true
ENABLE_RBAC_MEMORY=true
ENABLE_XAI_OUTPUT=true

# Search Hyperparameters
RETRIEVAL_TOP_K_HYBRID=20
RERANKER_TOP_N=5
GRADER_RELEVANCE_THRESHOLD=0.65
